# =============================================================================
# share-access/SECRETS.template — credentials template. THIS file is tracked in git.
#
# To use it:
#   1. Copy this file to "SECRETS" (no extension) in the same folder:
#        cp share-access/SECRETS.template share-access/SECRETS
#   2. Open share-access/SECRETS and fill in the values below.
#   3. Run:  bash share-access/setup.sh
#
# share-access/SECRETS is git-ignored — it is never committed or pushed to GitHub.
# Do NOT put real credentials in THIS template; only in your SECRETS copy.
#
# This file is sourced by setup.sh as shell, so keep the KEY="value" format
# and the surrounding double quotes.
# =============================================================================

# IAM access key for the AWS account the deployment scripts manage.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# 12-digit AWS account id. Optional — used only to verify the keys point at
# the expected account.
AWS_ACCOUNT_ID=""
